# --- обязательное ---
# Токен от @BotFather
RATES_BOT_TOKEN=123456:AA...

# --- кто получает рассылку ---
# ID через запятую. Свой ID можно узнать у @userinfobot.
# Если пусто — подписаться можно командой /start (бот открыт для всех).
ADMIN_CHAT_IDS=

# --- какие валюты отслеживаем (коды ЦБ РФ, через запятую) ---
CURRENCIES=CNY,USD,EUR
# Валюта, по которой считается «просадка» в первую очередь (для авто из Китая — CNY)
PRIMARY_CURRENCY=CNY

# --- ежедневная сводка ---
DIGEST_TIME=10:00          # по Москве
DIGEST_ENABLED=true

# --- пороги «просадки» ---
DIP_DAILY_DROP_PCT=0.8     # падение за день, %
DIP_LOW_WINDOW_DAYS=30     # новый минимум за N дней
DIP_BELOW_MA_PCT=2.0       # ниже скользящей средней на N %
DIP_MA_WINDOW_DAYS=30      # окно скользящей средней
DIP_ALERTS_ENABLED=true

# --- биржевой курс (MOEX, только CNY) ---
MOEX_ENABLED=true
MOEX_INTRADAY_DROP_PCT=1.0 # внутридневное падение, %

# --- служебное ---
POLL_INTERVAL=900          # как часто опрашивать ЦБ, секунды
BACKFILL_YEARS=8           # сколько лет истории загрузить при первом запуске
DB_PATH=/data/rates.db
LOG_LEVEL=INFO
